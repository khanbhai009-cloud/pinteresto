# The Cozy Canvas (public site) — server-only env vars (ARCHITECTURE §8).
# Copy to .env.local for local dev, or set in the Vercel project settings.
# NONE of these may ever be prefixed with NEXT_PUBLIC_.

# Firebase Admin service account JSON, as ONE line. Get it from
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key. Paste it here / into Vercel — never commit the real value.
FIREBASE_SERVICE_ACCOUNT=

# Long random string used to salt the anonymous visitor hash (analytics).
ANALYTICS_SECRET=

# Public base URL of this site, e.g. https://thecozycanvas.example
SITE_URL=

# Upstash Redis (free tier) for /api/t rate limiting. Optional locally —
# without these, an in-memory limiter is used instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
